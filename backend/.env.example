NODE_ENV=development
PORT=3000

# Banco de Dados — SQLite (arquivo local, sem instalação necessária)
# O arquivo dev.db é criado automaticamente pelo Prisma na primeira migração
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="TROQUE_POR_UMA_CHAVE_SECRETA_FORTE_EM_PRODUCAO"
JWT_EXPIRES_IN=7d

# CORS — URL do front-end
FRONTEND_URL="http://localhost:5173"

# ViaCEP (configurações opcionais)
VIACEP_BASE_URL="https://viacep.com.br/ws"
VIACEP_CACHE_TTL=300
