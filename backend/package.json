{
  "name": "swiftcart-backend",
  "version": "1.0.0",
  "description": "SwiftCart E-commerce — API REST (Node.js + Express + Prisma + SQLite)",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "seed": "node scripts/seed.js",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:reset": "npx prisma migrate reset --force && node scripts/seed.js",
    "db:studio": "npx prisma studio",
    "setup": "npm install && npx prisma migrate dev --name init && node scripts/seed.js"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.1",
    "@prisma/client": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.6.0",
    "nodemon": "^3.0.1",
    "prisma": "^5.0.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/models/index.js"
    ]
  }
}
